    <ui:VisualElement name="LoseScreenContainer" style="flex-grow: 1; position: absolute; top: 0; left: 0%; bottom: 0; right: 0; align-items: center; justify-content: center; font-size: 14px; -unity-font-style: normal; opacity: 0; flex-shrink: 0;">
