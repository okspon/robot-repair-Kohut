    <ui:VisualElement name="HealthBarBackground" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/Demo_Art/SugarLand/UI/UIHealthFrameBlue.png?fileID=2800000&amp;guid=4e65018de1d892647ace9c1d6510e500&amp;type=3#UIHealthFrameBlue&quot;); background-size: 50% 50%; -unity-background-scale-mode: scale-to-fit; position: absolute; top: 2%; left: 2%; width: 30%; height: 15%;">
        <ui:VisualElement name="HealthBarContainer" style="flex-grow: 1; position: absolute; height: 65px; width: 209px; top: 46px; left: 251px; right: auto; flex-direction: row; overflow: hidden;">
            <ui:VisualElement name="HealthBar" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Art/SugarLand/UI/UIHealthBar.png?fileID=2800000&amp;guid=b28ee55f43291f14ab9219808f397b88&amp;type=3#UIHealthBar&quot;); -unity-background-scale-mode: scale-to-fit; width: 100%; height: 100%; top: 0%; flex-shrink: 0; left: 0%; flex-direction: row; overflow: hidden;"/>
